# ---------- Model ----------
# Your Anthropic API key (https://console.anthropic.com). Without it the app runs a built-in demo model.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
CLAUDE_MAX_TOKENS=2048
# MOCK_LLM=1            # force the demo model even if a key is set

# ---------- Auth ----------
# Owner login for the web UI. If empty, a one-time password is printed in the server logs.
OWNER_PASSWORD=change-me
# Long random string (e.g. `openssl rand -hex 32`). If empty, sessions reset on restart.
SESSION_SECRET=
SESSION_TTL_HOURS=168
SCREEN_TOKEN_TTL_SECONDS=600
# auto = Secure cookie only over HTTPS; set true behind a TLS proxy
COOKIE_SECURE=auto

# ---------- Server ----------
PORT=8787
DATA_DIR=./data
LOG_LEVEL=info

# ---------- Sandboxes ----------
# auto: Docker if reachable, else demo subprocess mode | docker: require Docker | subprocess: demo only
SANDBOX_MODE=auto
SANDBOX_IMAGE=botclone-sandbox:latest
SANDBOX_MEMORY_MB=512
SANDBOX_CPUS=1
SANDBOX_PIDS_LIMIT=256
# none (no network) | isolated (internal network, no internet) | egress (internet access)
SANDBOX_NETWORK=egress
SANDBOX_IDLE_MINUTES=30
SANDBOX_EXEC_TIMEOUT_SECONDS=60
# DOCKER_SOCKET=/var/run/docker.sock

# ---------- Context & memory ----------
CONTEXT_MAX_MESSAGES=40
CONTEXT_KEEP_MESSAGES=16
MEMORY_INJECT_LIMIT=100
AGENT_MAX_STEPS=8
